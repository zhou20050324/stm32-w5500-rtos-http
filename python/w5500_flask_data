from flask import Flask, request, jsonify, render_template_string
import csv
import os
from datetime import datetime

app = Flask(__name__)

# 存储最新传感器数据
latest = {
    "mcu_temp": 0.0,
    "light_v": 0.0,
    "vref": 0.0,
    "dht_temp": 0.0,
    "dht_humi": 0.0,
    "timestamp": ""
}

# 历史数据（用于图表，保留最近 100 条）
history = {
    "timestamps": [],
    "mcu_temp": [],
    "light_v": [],
    "vref": [],
    "dht_temp": [],
    "dht_humi": []
}

@app.route('/upload', methods=['POST'])
def upload():
    """接收 STM32 上传的 JSON 数据"""
    data = request.get_json()
    if data:
        now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        data['timestamp'] = now
        latest.update(data)

        # 保存到 CSV
        fieldnames = ['timestamp', 'mcu_temp', 'light_v', 'vref', 'dht_temp', 'dht_humi']
        with open('sensor_data.csv', 'a', newline='') as f:
            writer = csv.DictWriter(f, fieldnames=fieldnames)
            if f.tell() == 0:
                writer.writeheader()
            writer.writerow({k: data[k] for k in fieldnames})

        # 更新历史数据（每个列表最多 100 点）
        for k in ['mcu_temp', 'light_v', 'vref', 'dht_temp', 'dht_humi']:
            history[k].append(data[k])
            if len(history[k]) > 100:
                history[k].pop(0)
        history['timestamps'].append(now)
        if len(history['timestamps']) > 100:
            history['timestamps'].pop(0)

        return jsonify({'status': 'ok'}), 200
    return jsonify({'error': 'no data'}), 400

@app.route('/api/latest')
def api_latest():
    """返回最新一条数据"""
    return jsonify(latest)

@app.route('/api/history')
def api_history():
    """返回历史数据（用于图表）"""
    return jsonify(history)

@app.route('/')
def index():
    """实时仪表盘（带 ECharts 图表）"""
    return render_template_string(HTML_PAGE)

